{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.2",
    "path": [
      "?.lua",
      "?/init.lua",
      "src/?.lua",
      "src/?/init.lua",
      "src/*/?.lua",
      "src/*/?/init.lua",
      "src/*/?/?.lua",
      "src/*/*/?.lua",
      "src/*/*/?/init.lua",
      "src/*/*/?/?.lua",
      "lib/?.lua",
      "lib/?/init.lua",
      "tests/?.lua",
      "tests/*/*/?.lua"
    ]
  },
  "diagnostics": {
    "enable": true,
    "globals": [
      "peripheral",
      "rednet",
      "redstone",
      "fs",
      "os",
      "shell",
      "term",
      "textutils",
      "colors",
      "colours",
      "paintutils",
      "parallel",
      "turtle",
      "window",
      "keys",
      "sleep",
      "write",
      "printError",
      "read",
      "bit32",
      "describe",
      "it",
      "before_each",
      "after_each",
      "assert_eq",
      "assert_ne",
      "assert_true",
      "assert_false",
      "assert_nil",
      "assert_not_nil",
      "assert_near",
      "assert_deep_eq",
      "assert_contains",
      "assert_error",
      "assert_throws",
      "sdk",
      "mock",
      "harness_set_state"
    ],
    "disable": [
      "lowercase-global"
    ]
  },
  "workspace": {
    "checkThirdParty": false,
    "library": []
  }
}
